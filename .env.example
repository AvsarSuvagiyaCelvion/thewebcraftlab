# The WebCraft Lab - Environment Variables Configuration

# Form Submission Provider Option 1: Formspree (Recommended & Simplest)
# Get your form endpoint ID from https://formspree.io/
VITE_FORMSPREE_ID=your_formspree_form_id

# Form Submission Provider Option 2: EmailJS
# Get these from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Brand / Contact Info (Overrides defaults if provided)
VITE_SITE_EMAIL=thewebcraftlab@gmail.com
VITE_SITE_INSTAGRAM=https://instagram.com/thewebcraftlab
VITE_SITE_LOCATION="Surat, Gujarat, India"
